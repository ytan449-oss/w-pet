{
  "name": "w-pet-storefront",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/build-worker.mjs && node scripts/verify-worker.mjs",
    "dev:api": "node --env-file-if-exists=.env.local --import tsx scripts/dev-api.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.21.0"
  },
  "engines": {
    "node": ">=22"
  }
}
